# Neon（serverless PostgreSQL）— 見 docs/SCHEMA_GUIDE.md
# 應用執行期：pooled 連線（host 含 -pooler）
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/reeflog?sslmode=require"
# Migration 用：direct 連線（host 不含 -pooler）
DIRECT_URL="postgresql://user:password@ep-example.region.aws.neon.tech/reeflog?sslmode=require"
