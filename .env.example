# Neon serverless PostgreSQL — 從 Neon 專案 dashboard 的 Connection Details 取得
# DATABASE_URL：pooled 連線（host 含 -pooler），應用程式執行期使用
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/reeflog?sslmode=require"

# DIRECT_URL：direct 連線（host 不含 -pooler），Prisma migration 使用
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/reeflog?sslmode=require"

# ─────────────────────────────────────────────────────────────────────────────
# 認證（#47）— Google 登入已實作（#64），這三個變數為必填
#
# 少了它們的後果：
#   NUXT_SESSION_PASSWORD 沒設（或不足 32 字元）——h3 連「開一個空 session」都會在
#     seal 那一步拋錯，而沒有 cookie 的請求也會走到 seal。所以後果不是「大家都沒登入」，
#     而是每一支 API 都失敗。server/utils/authContext.ts 有一道隔離讓它退化成未登入
#     並留下 log，但那是防止全站癱瘓的安全網，不是可以不設的意思。
#     dev 模式下 nuxt-auth-utils 會自動產一組寫進 .env，所以本機不會踩到——
#     只有 production / preview 忘了設才會炸，那正是最難察覺的情境。
#   CLIENT_ID / SECRET 沒設——/auth/google 走 onError，導回 /login，登入永遠不會成功。
# 依 CLAUDE.md 的安全約束，實際值一律由人類設定，agent 不碰。
# 變數名稱是 nuxt-auth-utils 的慣例（NUXT_ 前綴由 Nuxt runtimeConfig 自動對應），不可改名。
# ─────────────────────────────────────────────────────────────────────────────

# 密封 cookie session 的加密／簽章金鑰。不向任何服務申請，自己產生：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# nuxt-auth-utils 要求至少 32 字元（randomBytes(32) 轉 base64 為 44 字元）。
# local 與 Vercel 可以、也建議用不同的值：local 洩漏不影響線上使用者。
# 換掉它等於把所有登入中的使用者登出——這正是 #47 第 2 節「無法提前撤銷」的緩解手段。
NUXT_SESSION_PASSWORD="replace-with-32-plus-chars-of-random-base64"

# Google OAuth client。Google Cloud Console → Credentials → Create OAuth client ID
# → Application type: Web application。
#
# Authorized redirect URIs 需填 <origin>/auth/google（nuxt-auth-utils 的預設 callback 路徑）：
#   http://localhost:3000/auth/google        ← Google 僅對 localhost 允許 http
#   https://<production 網域>/auth/google
#
# 「Authorized JavaScript origins」不需填寫：這是 server-side authorization code flow。
#
# OAuth 同意畫面的 scope 只需 openid / userinfo.email / userinfo.profile，
# 三者皆為 non-sensitive，Publish 到 Production 不需要 Google 審查。
# 記得把 Publishing status 從 Testing 改為 Production，否則只有手動加入的
# test user（上限 100）登得進去。
#
# ⚠️ Google 的 redirect URI 不支援萬用字元，而 Vercel preview 每個 branch 一個動態網址，
#    無法逐條列舉 → preview deployment 上 Google 登入必然 redirect_uri_mismatch。
#    preview 驗證與 Playwright E2E 一律走「以訪客身分瀏覽」，詳見 #47。
NUXT_OAUTH_GOOGLE_CLIENT_ID="xxxxxxxxxxxx.apps.googleusercontent.com"

# CLIENT_SECRET 在 Vercel 上建議標記為 Sensitive（Vercel 僅允許 Preview / Production 標記，
# Development 本來就不能標，因此不會造成本機取不到）。標記後值再也讀不回來
# ——dashboard、vercel env ls、vercel env pull 都看不到，設定前先自行留存。
# CLIENT_ID 不必標 Sensitive：它會出現在 OAuth 導向網址的 query string，本來就是公開資訊。
NUXT_OAUTH_GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"

# ─────────────────────────────────────────────────────────────────────────────
# 圖片上傳（Vercel Blob）— 自訂頭像（#166 / #167）與生物照片（#154）共用同一個 store
#
# 少了它的後果：兩處上傳都會在打到 Blob store 那一步失敗（`@vercel/blob` 找不到
#   token），使用者看到的是「上傳失敗，請確認網路後再試一次」。**其餘功能一律不受
#   影響**——讀取、記錄、保養提醒都不碰 Blob，所以本機不試上傳的話可以不設。
#
# 取得方式：Vercel dashboard → Storage → 建立一個 Blob store → 連結到本專案，
# 之後 `vercel env pull` 會把它帶進本機的 .env。名稱是 `@vercel/blob` 的預設慣例，
# 不可改名（改了就得在程式碼裡明寫 token，而那正是下面那條要避免的事）。
#
# ⚠ 一定要依 Production / Preview 兩個 scope **各設一個 store 的 token**（由人類維護）。
#    preview 的 Neon 分支是從 production 複製來的，可能帶著一模一樣的 id 與圖片 URL——
#    共用同一個 token 的話，preview 上的一次刪除就會打掉正式環境的圖片。
#    程式碼裡刻意不出現 token（見 server/utils/blobStore.ts），也因此它絕不能進
#    runtimeConfig.public 或任何前端 bundle。
#
# 依 CLAUDE.md 的安全約束，實際值一律由人類設定，agent 不碰。
# ─────────────────────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_replace_with_store_token"
