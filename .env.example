# Neon serverless PostgreSQL — 從 Neon 專案 dashboard 的 Connection Details 取得
# DATABASE_URL：pooled 連線（host 含 -pooler），應用程式執行期使用
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/reeflog?sslmode=require"

# DIRECT_URL：direct 連線（host 不含 -pooler），Prisma migration 使用
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/reeflog?sslmode=require"
