// ReefLog — 資料模型草稿
//
// 來源：Epic #1「畫面建置」的全部 7 張截圖：
//   screen-1 首頁（預設收合）        screen-5 生物庫存
//   screen-2 首頁（數據儀表板展開）   screen-6 生物詳情 · 死亡記錄
//   screen-3 水質記錄                screen-7 保養提醒
//   screen-4 趨勢圖
//
// Epic #47「登入與資料歸屬」追加 1 張截圖：
//   screen-1（#47）登入畫面 00a——「使用 Google 繼續」／「以訪客身分瀏覽」，
//                  副標題「目前 Google + 訪客 · 其他方式預留」
//   → 新增 Account model 與 AuthProvider enum；User.email 改為 nullable（唯一約束保留）。
//   → session 策略是密封 cookie（內容只有 { userId, exp }，驗簽即得身分、不查 DB），
//     所以刻意「不」建 Session model——這是 #47 已定案的取捨，不是漏掉。
//
// 以下註解中未特別標註的 screen-N 一律指 Epic #1 的截圖；#47 的那一張寫成 screen-1（#47）。
//
// 慣例依 docs/SCHEMA_GUIDE.md：model 單數 PascalCase、欄位 camelCase、
// 主鍵 cuid()、每個 model 都有 createdAt / updatedAt、金額與量測值用 Decimal。
//
// 設計原則：畫面上任何「算得出來的東西」都不進資料庫，例如
//   - 「存活 · 8 月」、「在缸天數 189 天」→ 由 addedOn（死亡則到 diedOn）推算
//   - 「觀察第 3 天」→ 由 observedSickOn 推算
//   - 「2 需注意」、「偏低 ▼ / 偏高 ▲」→ WaterReading.value 與 WaterParameterTarget 比較
//   - 「更新於 4 小時前」、「4 天前」→ 由 measuredAt 推算
//   - 趨勢頁的平均 / 最高 / 最低 / 期間變化量 → 由該區間的 WaterReading 聚合
//   - 保養的「下次到期」「3 天後」→ 由最後一次完成時間 + intervalDays 推算
//   - 生物的總成本 / 存活價值 / 死亡價值 → 由 price + status 動態計算
//   - 生物列表的「公子小丑 ×2」→ 由應用層依 name 分組計數（一隻生物 = 一列）
//   - 「預設缸」→ 該使用者的缸依 displayOrder ASC, createdAt ASC 排序後的第一個，不另設旗標

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // 應用執行期：Neon pooled 連線（host 含 -pooler）
  directUrl = env("DIRECT_URL") // migration 用：Neon direct 連線（host 不含 -pooler）
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// 使用者與認證
// ─────────────────────────────────────────────

/// 一位使用者可有多個缸（Epic #1 screen-1 上方缸名旁的 ∨ 可切換）。
///
/// 身分識別「不在」這張表上，而在 Account：一位使用者可以有多種登入方式，
/// User 只放跨登入方式共用的個人資料。所有資料歸屬都以 User.id 為根——
/// 缸掛在 User 之下，生物 / 水質 / 保養再掛在缸之下，因此 server 端的授權
/// 一律是「先確認該缸屬於當前使用者」，不需要把 userId 反正規化到每張表。
model User {
  id String @id @default(cuid())

  /// Google 回傳的 email。訪客帳號一律為 null（訪客沒有 email）。
  ///
  /// 由 `String @unique` 改成 `String? @unique`：**只放寬 null，保留唯一約束。**
  ///
  ///   - 可為 null：email 不再是身分來源（身分是 Account 的
  ///     (provider, providerAccountId)）。訪客帳號沒有 email；而「其他方式預留」
  ///     的登入方式也不保證給得出 email（例如 Apple 的隱藏信箱）。
  ///     Postgres 的 UNIQUE 視多個 NULL 為互異，所以「可空」與「唯一」並不衝突——
  ///     語義恰好是「email 可有可無，但有值就必須唯一」，這正是下面要的。
  ///
  ///   - 保留 @unique：Epic #47 第 7 節定案「同一個 email 從第二種登入方式進來時，
  ///     要視為同一個帳號」（account linking）。linking 的登入流程是
  ///       ① 以 (provider, providerAccountId) 查 Account → 命中即結束
  ///       ② 未命中 → 以 email 查 User → 命中則替既有 User 建一列新 Account
  ///       ③ 仍未命中 → 建新的 User + Account
  ///     第 ② 步永遠不會插入重複 email，所以 P2002 不會觸發；反之若 email 不唯一，
  ///     第 ② 步只能用 findFirst，一旦累積出重複 email 就是不確定行為。
  ///     **唯一約束是 linking 的正確性保證，不是它的阻礙。**
  ///
  ///     即使 linking 排在 MVP 之後實作，約束現在就得留著：日後要「加回」@unique，
  ///     若 production 已累積重複 email，migration 會失敗、得先清資料；
  ///     日後要「移除」則永遠安全。方向不對稱，所以選現在保留。
  email String? @unique

  /// 顯示名稱。Google 登入取回傳的 name；訪客固定為「訪客」。
  displayName String?

  createdAt DateTime @default(now())
  /// 最近一次辨識出這位使用者並準備續發 session 的時間。
  ///
  /// 訪客沙盒清理以這個欄位而非 createdAt 判斷逾期：長期使用的訪客會持續更新，
  /// 不會因為帳號建立超過保留期、卻仍持有有效 cookie 而被刪掉。新建帳號由資料庫
  /// default 設為建立時間；續發 session 前更新它，寫 session 失敗時最多多保留資料，
  /// 不會反向刪除仍可能有效的沙盒。
  lastActiveAt DateTime @default(now())

  /// 訪客沙盒複製完成的時間。**null ＝ 這位使用者還欠一份沙盒。**
  ///
  /// issue #144：複製示範資料要 11.5 秒，佔 `/auth/guest` 全部耗時的 78%，而那 302 是
  /// handler 最後一行才發的——使用者因此在登入頁前面乾等十幾秒。複製移出登入請求之後，
  /// 「這位訪客的沙盒建好了沒」就不再是同一次請求內的事，需要一個查得到的狀態。
  ///
  /// 為什麼是可空的時間戳而不是布林：布林只答得出「好了沒」，答不出「什麼時候好的」，
  /// 而卡在半路的訪客要靠這個欄位找得出來。null 同時是複製那一步的**冪等鎖**——
  /// `updateMany({ where: { sandboxSeededAt: null } })` 搶得到才複製，
  /// 連點兩下或兩個分頁同時打都只會複製一份（見 server/utils/guestSandbox.ts）。
  ///
  /// Google 使用者建立當下就填上現在：他們沒有沙盒要複製，欄位語義是「沒有欠著的複製」，
  /// 不是「複製過了」。留 null 的話首頁會永遠停在「正在準備示範資料」。
  ///
  /// 既有的使用者由 migration 一併回填成各自的 createdAt——他們的沙盒在登入當下就複製完了。
  /// 不回填的話下次進站會被判定為「還欠一份」，於是**再複製一份**，缸直接變兩倍。
  sandboxSeededAt DateTime?

  updatedAt DateTime @updatedAt

  accounts Account[]
  tanks    Tank[]
}

/// 一組「登入方式 ↔ 使用者」的對應——screen-1（#47）的兩顆按鈕各對應一種 provider。
///
/// 採 Epic #47「涉及的資料模型」列出的做法 B（人類指定，理由是 MVP 可能新增
/// 其他登入項目）。做法 A（User.googleId）改動更小，但加第二家 provider 就得再動
/// 一次 schema；而 screen-1 的副標題「其他方式預留」已經把那件事畫在畫面上了，
/// 所以這一張不算「無畫面對應的預留」。
///
/// 登入流程：以 (provider, providerAccountId) 查這張表——
///   查到 → 取 userId 發 session；查不到 → 建 User + Account（首次登入自動建帳號）。
///
/// 刻意「不」存 access / refresh token：登入完成後不再呼叫 Google 的 API，
/// 存了只是多一份得保護的機密資料。
model Account {
  id     String @id @default(cuid())
  userId String

  provider AuthProvider

  /// provider 端那個帳號的穩定識別碼：
  ///   GOOGLE → OIDC 的 sub（不是 email——email 可以變更，sub 不會）
  ///   GUEST  → 每位訪客各自一個隨機 id，於首次進站時產生並寫入其密封 cookie。
  ///            「訪客」不是一個共用帳號，見 enum AuthProvider.GUEST 的說明。
  providerAccountId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 登入時唯一的查詢路徑，同時保證同一個 provider 帳號不會掛到兩位使用者身上。
  @@unique([provider, providerAccountId])
  /// 刻意「不」加 @@unique([userId, provider])：那會禁止同一位使用者掛兩個 Google
  /// 帳號，而目前沒有畫面需要這個限制。
  ///
  /// FK 欄位的索引 Prisma 不會自動建。這裡需要它是為了刪除使用者時的 cascade——
  /// Postgres 不會替 referencing 欄位建索引，少了它每刪一位使用者就全表掃一次。
  @@index([userId])
}

/// 登入方式。screen-1（#47）只有兩顆按鈕：「使用 Google 繼續」「以訪客身分瀏覽」。
/// 副標題寫「其他方式預留」，但 enum 加值是無痛 migration，所以現在不預列。
enum AuthProvider {
  GOOGLE

  /// 訪客身分。**每位訪客一個獨立帳號**，不是共用的示範帳號（Epic #47 第 6 節定案）：
  /// 首次進站建一位新的 User，並複製一份示範資料掛在他名下，密封 cookie 帶他自己的
  /// userId。prisma/seed.ts 建的那一份因此是「永遠沒人登入的模板」。
  ///
  /// 沒有走「訪客唯讀」：ReefLog 是記錄工具，訪客不能記錄就等於看不到主要功能。
  /// 共用帳號 + 可寫則會讓訪客互相干擾，而且示範缸能被任何人弄髒——這是作品集，
  /// 下一位進站的人看到的就是那個。（定案當時 production 與 preview 還共用同一個 Neon
  /// 分支，弄髒是兩邊一起髒；2026-08-01 起兩者已分開，但「訪客互相干擾」與「示範缸被
  /// 弄髒」這兩個理由不受影響。）獨立沙盒同時解掉這兩件事，也讓授權邏輯對訪客與
  /// Google 使用者完全一致（不需要在每支寫入 API 上判斷 provider）。
  ///
  /// 清理靠 User → Tank → {WaterLog, Creature, MaintenanceTask} 全鏈的 onDelete: Cascade：
  /// 刪掉 provider = GUEST 且 User.lastActiveAt 逾期的使用者，整棵資料自動消失。
  /// Account.@@index([userId]) 就是為這件事存在的。
  ///
  /// 另外，Vercel preview 無法逐 branch 去 Google Console 登記 redirect URI
  /// （Google 不支援萬用字元），所以訪客是 preview 與 E2E 唯一走得通的登入路徑，
  /// 不只是便利功能。獨立沙盒讓 E2E 各跑在自己的沙盒裡，測試之間不互相污染。
  GUEST
}

// ─────────────────────────────────────────────
// 缸
// ─────────────────────────────────────────────

/// screen-1 / 3 / 4 / 7 頁首共用：「主缸 · 4 尺」「SPS MIXED · 420L」與左側色塊。
model Tank {
  id     String @id @default(cuid())
  userId String

  /// 缸名，例：主缸
  name String

  /// 尺寸標示（使用者自填的口語尺寸），例：4 尺
  sizeSpec String?

  /// 水量（公升），例：420
  volumeLiters Int?

  /// 飼養型態標示，例：SPS MIXED
  /// 草稿先用自由字串：「SPS MIXED」是複合詞，先不硬塞進 enum，待人類定案。
  setupType String?

  /// 缸的代表色（頁首色塊 / 切換選單），存 #RRGGBB
  colorHex String?

  /// 開缸日期（缸齡來源）
  startedOn DateTime? @db.Date

  /// 切換選單中的排序。同時定義「預設缸」＝ 同一使用者的缸依
  ///   ORDER BY displayOrder ASC, createdAt ASC LIMIT 1
  /// 取出的那一個（screen-1 開啟 App 時顯示哪個缸）。
  ///
  /// 不另設 isDefault 旗標：「設為預設」等同「移到第一位」，兩個概念合一，
  /// 不會出現兩個預設缸。
  ///
  /// 刻意不加 @@unique([userId, displayOrder])：唯一約束加在排序欄位上，
  /// 會讓「重新排序」必須經過暫時值（Postgres 的 unique 預設非 DEFERRABLE，
  /// 兩個缸對調得走三步），而重排正是這個欄位存在的理由；且與 @default(0)
  /// 併用時建立第二個缸會直接失敗。確定性改由 createdAt 這個 tiebreaker 提供。
  displayOrder Int @default(0)

  /// 封存時間。缸只封存不真刪（軟刪除）——刪一個缸等於永久失去其下所有
  /// 生物的死亡記錄與多年水質歷史，這兩者是本 App 的核心資產。
  /// 非 null 即視為已封存，不出現在 screen-1 的缸切換選單。
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatures        Creature[]
  waterLogs        WaterLog[]
  waterTargets     WaterParameterTarget[]
  maintenanceTasks MaintenanceTask[]

  /// 支援「取某使用者的所有缸、依顯示順序排列」——缸切換選單與預設缸的查詢。
  /// Prisma 不會為 relation 的外鍵自動建索引，userId 需要自己來。
  @@index([userId, displayOrder])
}

// ─────────────────────────────────────────────
// 水質
// ─────────────────────────────────────────────

/// 一次下測 = 一筆 WaterLog，其下每個測項 = 一筆 WaterReading。
///
/// screen-1 的彩色數字列、screen-2 的儀表板、screen-3 的歷史記錄、
/// screen-4 的趨勢折線，全部是「這一組資料」的四種呈現，不另立 model。
///
/// 用「一筆量測事件 + 多筆讀數」而非把 6 個測項攤成 6 個欄位，理由：
///   1. screen-3 明確允許只填部分測項（NO₃ / PO₄ / 鹽度 顯示「—」未填），
///      攤平會留下大量語意不明的 null；
///   2. 之後要加測項（如 PH、溫度）不必改 schema；
///   3. 每個測項的正常區間（screen-2 右側 7–9、380–450…）可直接以 parameter 對應。
model WaterLog {
  id     String @id @default(cuid())
  tankId String

  /// 實際量測時間（screen-3 的日期 07/08 + 時間 21:30 合成，不是建檔時間）。
  /// screen-1 的「· 4h」、screen-2 的「更新於 4 小時前」、screen-3 的「4 天前」由此推算。
  measuredAt DateTime

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tank     Tank           @relation(fields: [tankId], references: [id], onDelete: Cascade)
  readings WaterReading[]

  @@index([tankId, measuredAt])
}

/// 單一測項的讀數。
/// screen-4 的折線 = 同一 parameter 依 measuredAt 排序的序列；
/// screen-3 每個輸入框右側的「上次 8.0」= 同一 parameter 前一筆的 value。
model WaterReading {
  id         String         @id @default(cuid())
  waterLogId String
  parameter  WaterParameter

  /// 讀數值。用 Decimal 避免浮點誤差（鹽度 1.026、PO₄ 0.04 需要小數精度）
  value Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  waterLog WaterLog @relation(fields: [waterLogId], references: [id], onDelete: Cascade)

  /// 同一次量測中，同一個測項只會有一筆讀數。
  /// 「未量測」以「不建立此列」表示，而不是存 null。
  ///
  /// 刻意不加 @@index([parameter])：只有 6 個值、選擇性極低，planner 不會選它。
  /// screen-4 的趨勢查詢實際走 WaterLog 的 [tankId, measuredAt] 撈出區間，
  /// 再 join readings 過濾 parameter；單缸一年約 50–100 筆 log，join 不是瓶頸，
  /// 也因此不把 tankId / measuredAt 反正規化到這裡。
  @@unique([waterLogId, parameter])
}

/// 每個缸、每個測項的正常區間（screen-2 右側的 7–9、380–450、1250–1350…，
/// 同一份區間也是 screen-4 折線圖的背景色帶）。
/// 放在 Tank 之下而非寫死常數：不同飼養型態（SPS / 軟體）目標值不同。
/// 沒有設定的測項由應用層套用預設區間。
model WaterParameterTarget {
  id        String         @id @default(cuid())
  tankId    String
  parameter WaterParameter

  /// 正常區間下限；低於此值 → screen-2 顯示「偏低 ▼」
  minValue Decimal @db.Decimal(10, 4)

  /// 正常區間上限；高於此值 → screen-2 顯示「偏高 ▲」
  maxValue Decimal @db.Decimal(10, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tank Tank @relation(fields: [tankId], references: [id], onDelete: Cascade)

  @@unique([tankId, parameter])
}

/// 測項。screen-1 / 2 / 3 / 4 的六項是同一組定義。
/// 單位（dKH / ppm / SG）是測項本身固有的性質，屬於應用層常數，不重複存進資料庫。
/// 只列畫面上實際出現的六項：enum 加值是無痛 migration、減值才痛，
/// 所以不預留 PH / TEMPERATURE。
enum WaterParameter {
  KH
  CA
  MG
  NO3
  PO4
  SALINITY
}

// ─────────────────────────────────────────────
// 生物
// ─────────────────────────────────────────────

/// screen-1 的生物卡片、screen-5 的庫存列表、screen-6 的生物詳情，
/// 是同一個 model 的三種呈現。
///
/// 一隻生物 = 一列。screen-1 / screen-5 的「公子小丑 ×2」由應用層依 name
/// （或 scientificName）分組計數呈現，schema 不設 quantity 欄位：
/// status / observedSickOn / diedOn / causeOfDeath / price 全都是「單一個體」
/// 的屬性，2 隻死 1 隻是常見情境，共用一列無法表達；同時也解掉了
/// 「不同時間、不同價格購入」在同一列存不下的問題。
model Creature {
  id     String @id @default(cuid())
  tankId String

  /// 俗名，例：藍倒吊、榔頭珊瑚、火焰仙
  name String

  /// 學名，例：Paracanthurus、Amphiprion、Centropyge loriculus
  /// （screen-5 列表第二行、screen-6 名稱下方）
  scientificName String?

  category CreatureCategory

  /// 細分類標籤，例：神仙（screen-6 的「魚 · 神仙」後半段）。
  /// 用自由字串而非 enum：魚 / 珊瑚 的細分族群非常多，硬列舉會頻繁改 schema。
  subCategory String?

  /// 建檔時拍攝的照片；null → 畫面改用預設圖示
  photoUrl String?

  /// 入缸日期（screen-6「入缸日 2025/11/12」）。
  /// 「入缸 8 月」「在缸天數 189 天」由此推算——生物已死亡時算到 diedOn，否則算到今天。
  addedOn DateTime @db.Date

  /// 這一隻的購入價。總成本 / 存活價值 / 死亡價值一律由 price + status
  /// 動態計算（跨列聚合），不存衍生欄位
  price Decimal? @db.Decimal(10, 2)

  status CreatureStatus @default(ALIVE)

  /// 發病日 / 觀察到生病的日期（screen-6 死亡記錄區的「發病日 05/16」）。
  /// 生病中 → screen-1 的「⚠ 觀察中」、screen-5 的「觀察第 3 天」由此推算；
  /// 已死亡 → 仍保留，作為死亡記錄的發病日。
  /// 刻意讓「生病」與「死亡」共用同一欄，避免同一個日期在兩處各存一份而失去一致性。
  observedSickOn DateTime? @db.Date

  /// 症狀 / 病名，例：白點（screen-1「生病 · 白點」、screen-5「白點 · 觀察第 3 天」）
  ailment String?

  /// 死亡日（screen-6「死亡日 05/20」、screen-5「跳缸 · 05/20」）
  diedOn DateTime? @db.Date

  causeOfDeath DeathCause?

  /// 死亡記錄專用備註。「只」對應 screen-6 死亡記錄區塊內的那一個備註欄，
  /// 例：「半夜跳出主缸，早上發現已乾。之後加裝上蓋防跳網。」
  /// 不是生物的通用備註——目前 7 張畫面沒有「存活期間的飼養備註」輸入位置，
  /// 因此刻意不預留通用的 note 欄位（加 nullable 欄位是無痛 migration，
  /// 先留著反而讓對照表出現無畫面對應、日後被誤認為漏做 UI 的欄位）。
  deathNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tank Tank @relation(fields: [tankId], references: [id], onDelete: Cascade)

  @@index([tankId, status])
  @@index([tankId, category])
}

/// screen-1 的篩選 chip 與 screen-5 的分類 tab：全部 / 魚 / 珊瑚 / 其他
enum CreatureCategory {
  FISH
  CORAL
  OTHER
}

/// screen-1 卡片右上角狀態點、screen-5 的狀態 filter、screen-6 的狀態切換：
/// 存活（綠）／生病 · 觀察中（橘）／死亡（灰）
enum CreatureStatus {
  ALIVE
  SICK
  DEAD
}

/// 死因。對應 screen-6 的六個選項，也對應 SCHEMA_GUIDE 列出的
/// disease / water_quality / predation / jumped / starvation / unknown
enum DeathCause {
  /// 生病
  DISEASE
  /// 水質變化
  WATER_QUALITY
  /// 被獵食 / 打架
  PREDATION
  /// 跳缸
  JUMPED
  /// 餓死（不開口）
  STARVATION
  /// 原因不明
  UNKNOWN
}

// ─────────────────────────────────────────────
// 保養提醒（screen-7）
// ─────────────────────────────────────────────

/// 週期性保養任務的「定義」，例：換水 10%（每 7 天）、折射計校正（每 30 天）、餵食（每天）。
///
/// 「上次 07/01」「下次到期」「今天該做 / 3 天後」全部是推算值，不存欄位：
///   lastCompletedAt = 最後一筆 MaintenanceCompletion.completedAt
///   nextDueOn       = (lastCompletedAt 的日期 ?? startOn) + intervalDays
model MaintenanceTask {
  id     String @id @default(cuid())
  tankId String

  /// 任務名稱，例：換水 10%、洗前置棉、洗濾材 / 生化球、換活性碳、餵食
  name String

  /// 週期天數。「每天」= 1、「每 7 天」= 7、「每 30 天」= 30、「每 60 天」= 60
  intervalDays Int

  /// 尚無任何完成紀錄時，用來起算第一次到期日；null 則視為建立當天起算
  startOn DateTime? @db.Date

  /// 停用而不刪除（保留歷史完成紀錄）
  isActive Boolean @default(true)

  /// 清單內的排序
  displayOrder Int @default(0)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tank        Tank                    @relation(fields: [tankId], references: [id], onDelete: Cascade)
  completions MaintenanceCompletion[]

  @@index([tankId, isActive, displayOrder])
}

/// 單次「做完了」的紀錄——screen-7 勾選 checkbox 就新增一筆，取消勾選則刪除當天那筆。
/// 與 MaintenanceTask 分開存而不是在 task 上塞一個 lastDoneOn 欄位，理由：
///   1. screen-7 的「已完成 08:20」需要完成的「時刻」，不只是日期；
///   2. 保留完整履歷，日後要做保養歷史 / 統計不必改 schema；
///   3. 「上次 07/01」與「下次到期」因此都是推算值，不會與實際履歷不同步。
model MaintenanceCompletion {
  id     String @id @default(cuid())
  taskId String

  /// 實際完成時間（screen-7「已完成 08:20」）
  completedAt DateTime @default(now())

  /// 完成日（completedAt 的日期部分），用於保證一天一筆。
  /// screen-7 的行為是「勾選 = 新增一筆、取消 = 刪除當天那筆」，
  /// 沒有這道約束時連點兩下或多裝置同步都會產生假重複的保養履歷。
  completedOn DateTime @db.Date

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task MaintenanceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, completedOn])
  @@index([taskId, completedAt])
}
