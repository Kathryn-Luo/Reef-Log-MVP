// ReefLog — 資料模型草稿
//
// 來源：Epic #1「畫面建置」的 screen-1（首頁預設）與 screen-2（數據儀表板展開）。
// 慣例依 docs/SCHEMA_GUIDE.md：model 單數 PascalCase、欄位 camelCase、
// 主鍵 cuid()、每個 model 都有 createdAt / updatedAt、金額與量測值用 Decimal。
//
// 設計原則：畫面上任何「算得出來的東西」都不進資料庫，例如
//   - 「存活 · 8 月」→ 由 addedOn 推算
//   - 「2 需注意」、「偏低 ▼ / 偏高 ▲」→ 由 WaterReading.value 與 WaterParameterTarget 比較
//   - 「更新於 4 小時前」→ 由最新一筆 WaterLog.measuredAt 推算
//   - 生物的總成本 / 存活價值 / 死亡價值 → 由 price + status 動態計算

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // 應用執行期：Neon pooled 連線（host 含 -pooler）
  directUrl = env("DIRECT_URL") // migration 用：Neon direct 連線（host 不含 -pooler）
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────
// 使用者與缸
// ─────────────────────────────────────────────

/// 一位使用者可有多個缸（screen-1 上方缸名旁的 ∨ 可切換）。
/// 註：認證機制尚未決定，這裡只放缸歸屬所需的最小欄位。
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  displayName String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tanks Tank[]
}

/// screen-1 頁首：「主缸 · 4 尺」／「SPS MIXED · 420L」與左側色塊。
model Tank {
  id       String @id @default(cuid())
  userId   String
  /// 缸名，例：主缸
  name     String
  /// 尺寸標示（使用者自填的口語尺寸），例：4 尺
  sizeSpec String?
  /// 水量（公升），例：420
  volumeLiters Int?
  /// 飼養型態標示，例：SPS MIXED
  /// 草稿先用自由字串：「SPS MIXED」是複合詞，先不硬塞進 enum，待人類定案。
  setupType String?
  /// 缸的代表色（頁首色塊 / 切換選單），存 #RRGGBB
  colorHex String?
  /// 開缸日期（缸齡來源）
  startedOn DateTime? @db.Date
  /// 開啟 App 時預設顯示的缸；同一位使用者只應有一個為 true（由應用層維持）
  isDefault Boolean @default(false)
  /// 切換選單中的排序
  displayOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  creatures  Creature[]
  waterLogs  WaterLog[]
  waterTargets WaterParameterTarget[]

  @@index([userId, displayOrder])
}

// ─────────────────────────────────────────────
// 水質
// ─────────────────────────────────────────────

/// screen-1 的彩色數字列與 screen-2 的儀表板是「同一份資料」的兩種呈現，
/// 因此只有這一組 model：一次下測 = 一筆 WaterLog，其下每個項目 = 一筆 WaterReading。
/// 用「一筆量測事件 + 多筆讀數」而非把 6 個項目攤成 6 個欄位，理由：
///   1. 使用者常常只測其中幾項，攤平會留下大量 null 且語意不明；
///   2. 之後要加測項（如 PH、溫度）不必改 schema；
///   3. 每個項目的正常區間（screen-2 右側 7–9、380–450…）可直接以 parameter 對應。
model WaterLog {
  id        String   @id @default(cuid())
  tankId    String
  /// 實際量測時間（不是建檔時間）；screen-1 的「· 4h」與 screen-2 的「更新於 4 小時前」由此推算
  measuredAt DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tank     Tank           @relation(fields: [tankId], references: [id], onDelete: Cascade)
  readings WaterReading[]

  @@index([tankId, measuredAt])
}

/// 單一測項的讀數。screen-2 的走勢折線即是同一 parameter 依 measuredAt 排序的序列。
model WaterReading {
  id         String         @id @default(cuid())
  waterLogId String
  parameter  WaterParameter
  /// 讀數值。用 Decimal 避免浮點誤差（鹽度 1.026、PO4 0.04 需要小數精度）
  value      Decimal        @db.Decimal(10, 4)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  waterLog WaterLog @relation(fields: [waterLogId], references: [id], onDelete: Cascade)

  // 同一次量測中，同一個測項只會有一筆讀數
  @@unique([waterLogId, parameter])
  @@index([parameter])
}

/// 每個缸、每個測項的正常區間（screen-2 右側的 7–9、380–450、1250–1350…）。
/// 放在 Tank 之下而非寫死常數：不同飼養型態（SPS / 軟體）目標值不同。
/// 沒有設定的測項由應用層套用預設區間。
model WaterParameterTarget {
  id        String         @id @default(cuid())
  tankId    String
  parameter WaterParameter
  /// 正常區間下限；低於此值 → screen-2 顯示「偏低 ▼」
  minValue  Decimal        @db.Decimal(10, 4)
  /// 正常區間上限；高於此值 → screen-2 顯示「偏高 ▲」
  maxValue  Decimal        @db.Decimal(10, 4)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tank Tank @relation(fields: [tankId], references: [id], onDelete: Cascade)

  @@unique([tankId, parameter])
}

/// 測項。單位（dKH / ppm / 無單位）是測項本身固有的性質，
/// 屬於應用層常數，不重複存進資料庫。
enum WaterParameter {
  KH
  CA
  MG
  NO3
  PO4
  SALINITY
  /// 以下兩項畫面上未出現，依 SCHEMA_GUIDE 的領域概念先預留
  PH
  TEMPERATURE
}

// ─────────────────────────────────────────────
// 生物
// ─────────────────────────────────────────────

/// screen-1 下半部的生物卡片。
model Creature {
  id       String           @id @default(cuid())
  tankId   String
  /// 顯示名稱，例：藍倒吊、榔頭珊瑚
  name     String
  category CreatureCategory
  /// 同一張卡片的數量，例：「公子小丑 ×2」
  quantity Int              @default(1)
  /// 建檔時拍攝的照片；null → 畫面改用預設圖示
  photoUrl String?
  /// 入缸日期；卡片上的「· 8 月」由此推算
  addedOn  DateTime         @db.Date
  /// 購入單價。總成本 / 存活價值 / 死亡價值一律由 price + status 動態計算，不存衍生欄位
  price    Decimal?         @db.Decimal(10, 2)
  status   CreatureStatus   @default(ALIVE)
  /// 觀察到生病的日期；卡片的「⚠ 觀察中」由 status = SICK 且此欄位有值推導
  observedSickOn DateTime? @db.Date
  /// 症狀／病名，例：白點（卡片顯示為「生病 · 白點」）
  ailment      String?
  diedOn       DateTime?  @db.Date
  causeOfDeath DeathCause?
  note         String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tank Tank @relation(fields: [tankId], references: [id], onDelete: Cascade)

  @@index([tankId, status])
  @@index([tankId, category])
}

/// screen-1 的篩選 chip：全部 / 魚 / 珊瑚 / 其他
enum CreatureCategory {
  FISH
  CORAL
  OTHER
}

/// 卡片右上角狀態點：存活（綠）／生病・觀察中（橘）／死亡（灰）
enum CreatureStatus {
  ALIVE
  SICK
  DEAD
}

/// 死因，對應 SCHEMA_GUIDE 列出的
/// disease / water_quality / predation / jumped / starvation / unknown
enum DeathCause {
  DISEASE
  WATER_QUALITY
  PREDATION
  JUMPED
  STARVATION
  UNKNOWN
}
